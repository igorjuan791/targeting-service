# --- Build Stage ---
FROM python:3.11-slim AS builder

WORKDIR /app

# Copy requirements file
COPY requirements.txt .

# Install dependencies to a local directory
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# OpenTelemetry 
RUN pip install --no-cache-dir --prefix=/install \
    opentelemetry-distro==0.48b0 \
    opentelemetry-exporter-otlp==1.27.0 \
    opentelemetry-instrumentation-flask==0.48b0 \
    opentelemetry-instrumentation-psycopg2==0.48b0 \
    opentelemetry-instrumentation-requests==0.48b0

# --- Final Stage ---
FROM python:3.11-slim

# Create a non-root user and group
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

WORKDIR /app

# Copy only the installed dependencies from the builder stage
COPY --from=builder /install /usr/local

# Copy the application code
COPY . .

# Change ownership
RUN chown -R appuser:appgroup /app

# Switch to the non-root user
USER appuser

# Expose the port
EXPOSE 8003

# Define environment variables
ENV PORT=8003
ENV PYTHONUNBUFFERED=1

# Configuração OTel

ENV OTEL_SERVICE_NAME=targeting-service
ENV OTEL_RESOURCE_ATTRIBUTES=service.namespace=togglemaster,deployment.environment=prod
ENV OTEL_TRACES_EXPORTER=otlp
ENV OTEL_METRICS_EXPORTER=otlp
ENV OTEL_LOGS_EXPORTER=none
ENV OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Run the application
#CMD ["gunicorn", "-b", "0.0.0.0:8003", "app:app"]
CMD ["opentelemetry-instrument", "gunicorn", "-b", "0.0.0.0:8003", "app:app"]